---
import type { CollectionEntry } from 'astro:content'
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-card">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
      <p>{post.data.summary}</p>
      <a class="read-more" href={`/blog/${post.id}`}>続きを読む →</a>
    </article>
  ))}
</div>
