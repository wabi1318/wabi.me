---
import { profile } from '../content/profile'
---
<h1 class="page-title">自己紹介</h1>
<img alt="VB6風ウィンドウに表示されたwabiのプロフィール画像" class="profile-image about-profile-image" src="/favicon-vb6-character.png" width="240" height="240" />
<dl class="profile-table">
  <dt>名前</dt><dd>{profile.name}</dd>
  <dt>役割</dt><dd>{profile.role}</dd>
  <dt>拠点</dt><dd>{profile.location}</dd>
  <dt>関心</dt><dd>{profile.interests.join(' / ')}</dd>
</dl>
<p class="lead">{profile.introduction}</p>
